<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>ЭКОФЕРМЕР — производитель натуральных яблочных снеков под СТМ</title>
    <meta name="description" content="Контрактное производство яблочных снеков под СТМ с 2015 года. Сушка при 42°C, ISO 22000, HACCP. Производство в Краснодаре.">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #ffffff;
            color: #1a2a1f;
            line-height: 1.4;
        }

        .container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
        }

        /* Header */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 0;
            flex-wrap: wrap;
            gap: 16px;
            border-bottom: 1px solid #e8f0e6;
        }

        .logo {
            font-size: 24px;
            font-weight: 700;
            color: #2c5e2a;
            text-decoration: none;
        }

        .nav {
            display: flex;
            gap: 24px;
            flex-wrap: wrap;
        }

        .nav a {
            text-decoration: none;
            color: #2d3e2c;
            font-weight: 500;
            font-size: 15px;
            transition: color 0.2s;
        }

        .nav a:hover {
            color: #e67e22;
        }

        .btn-kp {
            background: #e67e22;
            color: white !important;
            padding: 8px 20px;
            border-radius: 40px;
        }

        .btn-kp:hover {
            background: #d35400;
        }

        /* Hero */
        .hero {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 48px;
            padding: 60px 0 40px;
            align-items: center;
        }

        .hero h1 {
            font-size: 42px;
            font-weight: 700;
            line-height: 1.2;
            color: #1a3a18;
            margin-bottom: 20px;
        }

        .hero p {
            font-size: 18px;
            color: #4a5e48;
            margin-bottom: 32px;
            line-height: 1.5;
        }

        .stats {
            display: flex;
            gap: 32px;
            margin: 32px 0;
        }

        .stat {
            text-align: left;
        }

        .stat-number {
            font-size: 32px;
            font-weight: 800;
            color: #e67e22;
        }

        .stat-label {
            font-size: 14px;
            color: #6b7a69;
        }

        .btn-orange {
            background: #e67e22;
            color: white;
            padding: 14px 32px;
            border-radius: 40px;
            text-decoration: none;
            font-weight: 600;
            display: inline-block;
            transition: background 0.2s;
            border: none;
            cursor: pointer;
            font-size: 16px;
        }

        .btn-orange:hover {
            background: #d35400;
        }

        /* Сетка с фото */
        .company-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 48px;
            padding: 60px 0;
            align-items: start;
        }

        .company-text h2 {
            font-size: 32px;
            margin-bottom: 24px;
            color: #1a3a18;
        }

        .company-text p {
            color: #4a5e48;
            line-height: 1.6;
            margin-bottom: 16px;
        }

        .company-text ul {
            list-style: none;
            margin-top: 20px;
        }

        .company-text li {
            margin-bottom: 12px;
            padding-left: 24px;
            position: relative;
            color: #4a5e48;
        }

        .company-text li:before {
            content: "✓";
            color: #e67e22;
            position: absolute;
            left: 0;
            font-weight: bold;
        }

        /* Галерея: вертикальное + два горизонтальных */
        .production-gallery {
            display: flex;
            gap: 20px;
        }

        .vertical-photo {
            flex: 1;
        }

        .vertical-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 20px;
            aspect-ratio: 3 / 4;
        }

        .horizontal-stack {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .horizontal-photo {
            width: 100%;
        }

        .horizontal-photo img {
            width: 100%;
            height: auto;
            object-fit: cover;
            border-radius: 20px;
            aspect-ratio: 16 / 9;
        }

        /* Остальные секции (сокращённо для примера) */
        .clients {
            padding: 40px 0;
            text-align: center;
            background: #fafaf8;
            border-radius: 32px;
            margin: 40px 0;
        }

        .clients-logos {
            display: flex;
            justify-content: center;
            gap: 48px;
            flex-wrap: wrap;
            font-weight: 600;
            color: #2c5e2a;
            font-size: 18px;
        }

        .footer {
            text-align: center;
            padding: 40px 0;
            color: #8ba188;
            font-size: 14px;
            border-top: 1px solid #e8f0e6;
            margin-top: 40px;
        }

        @media (max-width: 768px) {
            .hero, .company-grid {
                grid-template-columns: 1fr;
                gap: 32px;
            }
            .hero h1 {
                font-size: 32px;
            }
            .production-gallery {
                flex-direction: column;
            }
            .vertical-photo img {
                aspect-ratio: 16 / 9;
            }
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <a href="/" class="logo">ЭКОФЕРМЕР</a>
        <div class="nav">
            <a href="#">О компании</a>
            <a href="#">Партнёры</a>
            <a href="#">Ассортимент</a>
            <a href="#">Как работаем</a>
            <a href="#" class="btn-kp">Получить КП</a>
        </div>
    </div>

    <div class="hero">
        <div>
            <h1>Яблочные снеки, которым доверяют X5, ВкусВилл и Яндекс Лавка</h1>
            <p>Собственное производство в Краснодаре с 2015 года. 27+ СТМ-проектов, ISO 22000, HACCP.</p>
            <div class="stats">
                <div class="stat"><div class="stat-number">27+</div><div class="stat-label">СТМ-проектов</div></div>
                <div class="stat"><div class="stat-number">10+</div><div class="stat-label">лет опыта</div></div>
                <div class="stat"><div class="stat-number">3</div><div class="stat-label">дня на образцы</div></div>
            </div>
            <a href="#" class="btn-orange">Получить коммерческое предложение</a>
        </div>
        <div class="production-gallery">
            <div class="vertical-photo">
                <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 600 800'%3E%3Crect width='600' height='800' fill='%23e8f0e6'/%3E%3Ctext x='50%25' y='50%25' font-size='20' fill='%232c5e2a' text-anchor='middle' dy='.3em'%3EВертикальное фото%3C/text%3E%3C/svg%3E" alt="Производство вертикальное">
            </div>
            <div class="horizontal-stack">
                <div class="horizontal-photo">
                    <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 800 450'%3E%3Crect width='800' height='450' fill='%23e8f0e6'/%3E%3Ctext x='50%25' y='50%25' font-size='20' fill='%232c5e2a' text-anchor='middle' dy='.3em'%3EГоризонтальное фото 1%3C/text%3E%3C/svg%3E" alt="Производство горизонтальное 1">
                </div>
                <div class="horizontal-photo">
                    <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 800 450'%3E%3Crect width='800' height='450' fill='%23e8f0e6'/%3E%3Ctext x='50%25' y='50%25' font-size='20' fill='%232c5e2a' text-anchor='middle' dy='.3em'%3EГоризонтальное фото 2%3C/text%3E%3C/svg%3E" alt="Производство горизонтальное 2">
                </div>
            </div>
        </div>
    </div>

    <div class="company-grid">
        <div class="company-text">
            <h2>ЭКОФЕРМЕР — натуральные яблочные снеки под СТМ</h2>
            <p>Контрактное производство полного цикла: от кубанского сырья до готовой упаковки с вашим брендом.</p>
            <ul>
                <li>Более 10 лет опыта в переработке фруктов и выпуске здоровых снеков. Контрактное производство.</li>
                <li>Собственные мощности с современным оборудованием в Краснодаре.</li>
                <li>ISO 22000 и НАССР. Пройдены аудиты ВкусВилл, Х5, Яндекс Лавка.</li>
                <li>Кубанские яблоки, сушка при 42°С без консервантов и добавленного сахара.</li>
            </ul>
            <div style="margin-top: 32px;"><strong>Производство · Краснодар</strong><br>с 2015 года · сушка, обсыпки, глазирование в шоколаде</div>
        </div>
        <!-- Фото производства (дублировать не нужно, уже есть в hero) -->
        <div class="production-gallery">
            <div class="vertical-photo">
                <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 600 800'%3E%3Crect width='600' height='800' fill='%23e8f0e6'/%3E%3Ctext x='50%25' y='50%25' font-size='20' fill='%232c5e2a' text-anchor='middle' dy='.3em'%3EВертикальное фото%3C/text%3E%3C/svg%3E" alt="Производство">
            </div>
            <div class="horizontal-stack">
                <div class="horizontal-photo"><img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 800 450'%3E%3Crect width='800' height='450' fill='%23e8f0e6'/%3E%3Ctext x='50%25' y='50%25' font-size='20' fill='%232c5e2a' text-anchor='middle' dy='.3em'%3EГоризонтальное фото 1%3C/text%3E%3C/svg%3E" alt="Производство"></div>
                <div class="horizontal-photo"><img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 800 450'%3E%3Crect width='800' height='450' fill='%23e8f0e6'/%3E%3Ctext x='50%25' y='50%25' font-size='20' fill='%232c5e2a' text-anchor='middle' dy='.3em'%3EГоризонтальное фото 2%3C/text%3E%3C/svg%3E" alt="Производство"></div>
            </div>
        </div>
    </div>

    <div class="clients">
        <div class="clients-logos">
            <span>ВкусВилл</span>
            <span>X5 Group</span>
            <span>Яндекс Лавка</span>
        </div>
    </div>

    <div class="footer">
        © 2015–2025 ЭКОФЕРМЕР — производство натуральных яблочных снеков
    </div>
</div>

</body>
</html>
