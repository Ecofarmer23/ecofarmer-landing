---
// Ecofarmer STM Landing
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Производитель яблочных снеков под СТМ — Экофермер</title>
  <meta name="description" content="Контрактное производство яблочных снеков и сухофруктов под СТМ. ISO 22000, HACCP. 27+ проектов. X5, ВкусВилл, Яндекс Лавка." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --green: #4c8e2b; --green-dark: #3a6d20; --green-light: #d5efc3;
      --green-pale: #f6faf7; --orange: #ff8562; --text: #1a1a1a;
      --muted: #636661; --white: #ffffff; --gray: #efefef; --footer: #171717;
    }
    html { scroll-behavior: smooth; }
    body { font-family: 'Montserrat', sans-serif; color: var(--text); background: var(--white); overflow-x: hidden; }

    /* NAV */
    .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: var(--white); box-shadow: 0 2px 16px rgba(0,0,0,0.08); height: 64px; display: flex; align-items: center; justify-content: space-between; padding: 0 40px; }
    .nav__logo { font-weight: 800; font-size: 20px; color: var(--green); text-decoration: none; }
    .nav__logo span { color: var(--orange); }
    .nav__links { display: flex; gap: 28px; list-style: none; }
    .nav__links a { text-decoration: none; color: var(--green); font-weight: 600; font-size: 14px; transition: color 0.2s; }
    .nav__links a:hover { color: var(--orange); }
    .nav__cta { background: var(--orange) !important; color: var(--white) !important; padding: 10px 22px; border-radius: 30px; }
    .nav__cta:hover { background: #e06a44 !important; }

    /* HERO */
    .hero { position: relative; min-height: 100vh; display: flex; align-items: center; background: linear-gradient(to bottom, rgba(0,0,0,0.25), rgba(0,0,0,0.75)), url('/tild6463-3835-4730-a632-636139623239__lucid_origin_profess.jpg') center/cover no-repeat; background-color: #2d5a1b; padding-top: 64px; }
    .hero__inner { max-width: 1100px; margin: 0 auto; padding: 80px 40px; color: var(--white); }
    .hero__badge { display: inline-block; background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.3); padding: 6px 18px; border-radius: 30px; font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 24px; }
    .hero h1 { font-size: clamp(34px, 5vw, 62px); font-weight: 800; line-height: 1.1; max-width: 820px; margin-bottom: 20px; }
    .hero__sub { font-size: clamp(15px, 2vw, 20px); opacity: 0.88; max-width: 560px; margin-bottom: 36px; line-height: 1.5; }
    .hero__btns { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 60px; }
    .btn { display: inline-block; padding: 16px 36px; border-radius: 30px; font-weight: 700; font-size: 15px; text-decoration: none; border: none; cursor: pointer; transition: all 0.2s; font-family: 'Montserrat', sans-serif; }
    .btn-orange { background: var(--orange); color: var(--white); }
    .btn-orange:hover { background: #e06a44; transform: translateY(-2px); }
    .btn-ghost { background: rgba(255,255,255,0.12); color: var(--white); border: 2px solid rgba(255,255,255,0.45); }
    .btn-ghost:hover { background: rgba(255,255,255,0.22); }
    .btn-green { background: var(--green); color: var(--white); }
    .btn-green:hover { background: var(--green-dark); }
    .hero__stats { display: flex; gap: 48px; flex-wrap: wrap; }
    .stat__num { font-size: clamp(40px, 5vw, 60px); font-weight: 800; line-height: 1; }
    .stat__label { font-size: 13px; opacity: 0.75; margin-top: 4px; }

    /* PARTNERS */
    .partners { padding: 52px 40px; border-bottom: 1px solid #eee; }
    .partners__inner { max-width: 1100px; margin: 0 auto; text-align: center; }
    .partners__label { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); margin-bottom: 28px; }
    .partners__row { display: flex; justify-content: center; align-items: center; gap: 56px; flex-wrap: wrap; }
    .partner { font-size: 20px; font-weight: 800; color: #b0b0b0; transition: color 0.2s; }
    .partner:hover { color: var(--green); }

    /* ABOUT */
    .about { background: var(--green); padding: 80px 40px; }
    .about__inner { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 380px; gap: 60px; align-items: center; }
    .about__text { color: var(--white); }
    .about__title { font-size: clamp(22px, 3vw, 34px); font-weight: 800; margin-bottom: 28px; line-height: 1.2; }
    .about__title em { color: var(--orange); font-style: normal; }
    .about__item { display: flex; gap: 12px; margin-bottom: 18px; font-size: 15px; line-height: 1.6; opacity: 0.93; }
    .check { color: var(--orange); font-size: 17px; flex-shrink: 0; margin-top: 2px; }
    .about__photo { border-radius: 16px; overflow: hidden; aspect-ratio: 4/3; background: rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.35); font-size: 14px; text-align: center; padding: 20px; }

    /* FOR WHOM */
    .forwho { background: var(--green-pale); padding: 80px 40px; }
    .forwho__inner { max-width: 1100px; margin: 0 auto; }
    .s-title { font-size: clamp(24px, 3.5vw, 40px); font-weight: 800; text-align: center; margin-bottom: 14px; line-height: 1.2; }
    .s-sub { text-align: center; color: var(--muted); font-size: 16px; margin-bottom: 48px; max-width: 540px; margin-left: auto; margin-right: auto; line-height: 1.5; }
    .forwho__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .fw-card { background: var(--green); border-radius: 20px; padding: 32px 26px; color: var(--white); }
    .fw-card__title { font-size: 20px; font-weight: 800; margin-bottom: 18px; line-height: 1.3; }
    .fw-card ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
    .fw-card li { font-size: 14px; line-height: 1.5; opacity: 0.9; padding-left: 14px; position: relative; }
    .fw-card li::before { content: '—'; position: absolute; left: 0; opacity: 0.55; }

    /* ASSORTMENT */
    .assortment { padding: 80px 40px; background: var(--white); }
    .assortment__inner { max-width: 1100px; margin: 0 auto; }
    .product-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px; }
    .p-card { text-align: center; border-bottom: 2px solid #e0e6ed; padding-bottom: 28px; }
    .p-card__icon { width: 150px; height: 150px; background: var(--green-pale); border-radius: 50%; margin: 0 auto 18px; display: flex; align-items: center; justify-content: center; font-size: 52px; overflow: hidden; }
    .p-card__icon img { width: 100%; height: 100%; object-fit: cover; }
    .p-card__title { font-size: 20px; font-weight: 700; margin-bottom: 10px; line-height: 1.3; }
    .p-card__desc { font-size: 13px; color: var(--muted); line-height: 1.6; margin-bottom: 8px; }
    .p-card__cat { font-size: 11px; color: var(--green); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 18px; opacity: 0.8; }

    /* HOW */
    .howwork { background: var(--green-pale); padding: 80px 40px; }
    .howwork__inner { max-width: 1100px; margin: 0 auto; }
    .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 48px; }
    .step { text-align: center; padding: 28px 16px; }
    .step__num { font-size: 50px; font-weight: 800; color: var(--green); line-height: 1; margin-bottom: 14px; }
    .step__title { font-size: 17px; font-weight: 700; margin-bottom: 10px; }
    .step__desc { font-size: 13px; color: var(--muted); line-height: 1.6; }

    /* FORM */
    .formblock { background: var(--green-light); padding: 80px 40px; }
    .formblock__inner { max-width: 600px; margin: 0 auto; }
    .form-card { background: var(--white); border-radius: 20px; padding: 48px; border: 3px solid var(--green); box-shadow: 0 8px 40px rgba(0,0,0,0.12); text-align: center; }
    .form-card__title { font-size: 26px; font-weight: 800; text-transform: uppercase; margin-bottom: 8px; }
    .form-card__sub { color: var(--muted); font-size: 15px; margin-bottom: 28px; }
    .f-field { width: 100%; border: none; border-bottom: 2px solid #ddd; padding: 13px 4px; font-size: 15px; font-family: 'Montserrat', sans-serif; background: transparent; margin-bottom: 18px; outline: none; transition: border-color 0.2s; display: block; }
    .f-field:focus { border-color: var(--green); }
    .f-field::placeholder { color: #bbb; }
    .f-submit { width: 100%; background: var(--green); color: var(--white); border: none; padding: 17px; border-radius: 30px; font-size: 15px; font-weight: 700; font-family: 'Montserrat', sans-serif; cursor: pointer; transition: all 0.2s; margin-top: 6px; }
    .f-submit:hover { background: var(--green-dark); transform: translateY(-2px); }
    .f-privacy { font-size: 11px; color: var(--muted); margin-top: 14px; }
    .f-privacy a { color: var(--muted); }
    .f-success { display: none; background: var(--green-pale); border-radius: 12px; padding: 20px; color: var(--green); font-weight: 600; }

    /* CONTACTS */
    .contacts { background: var(--gray); padding: 72px 40px; text-align: center; }
    .contacts__inner { max-width: 500px; margin: 0 auto; }
    .contacts__phones { display: flex; flex-direction: column; gap: 6px; margin-bottom: 10px; }
    .contacts__phones a { font-size: 22px; font-weight: 700; color: var(--text); text-decoration: none; line-height: 1.7; transition: color 0.2s; }
    .contacts__phones a:hover { color: var(--green); }
    .contacts__email { font-size: 17px; margin-bottom: 6px; }
    .contacts__email a { color: var(--green); text-decoration: none; }
    .contacts__addr { font-size: 14px; color: var(--muted); margin: 12px 0 18px; }
    .contacts__tg a { color: var(--green); font-weight: 600; font-size: 14px; text-decoration: none; }

    /* FOOTER */
    footer { background: var(--footer); padding: 44px 40px; }
    .footer__inner { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; }
    .footer__logo { font-size: 19px; font-weight: 800; color: var(--white); text-decoration: none; }
    .footer__logo span { color: var(--orange); }
    .footer__copy { font-size: 12px; color: #777; margin-top: 5px; }
    .footer__link a { color: var(--white); text-decoration: none; font-size: 13px; opacity: 0.65; transition: opacity 0.2s; }
    .footer__link a:hover { opacity: 1; }

    /* MESSENGERS */
    /* VIDEO WIDGET */
    .video-widget { position: fixed; bottom: 28px; left: 28px; z-index: 200; width: 100px; border-radius: 12px; overflow: hidden; box-shadow: 0 8px 32px rgba(0,0,0,0.3); }
    .video-widget.hidden { display: none; }
    .video-widget__close { position: absolute; top: 6px; right: 6px; background: rgba(0,0,0,0.5); border: none; color: white; cursor: pointer; font-size: 12px; line-height: 1; padding: 3px 6px; border-radius: 4px; opacity: 0.8; transition: opacity 0.2s; z-index: 1; }
    .video-widget__close:hover { opacity: 1; }
    .video-widget__body { height: 180px; background: #000; position: relative; }

    .msng { position: fixed; bottom: 28px; right: 28px; z-index: 200; display: flex; flex-direction: column; gap: 10px; }
    .msng a { width: 50px; height: 50px; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 14px rgba(0,0,0,0.22); transition: transform 0.2s; }
    .msng a:hover { transform: scale(1.12); }
    .msng__tg { background: #29b6f6; }
    .msng__wa { background: #25d366; }

    /* MOBILE */
    @media (max-width: 768px) {
      .nav { padding: 0 20px; }
      .nav__links { display: none; }
      .hero__inner { padding: 60px 20px; }
      .hero__stats { gap: 24px; }
      .about__inner { grid-template-columns: 1fr; }
      .about__photo { display: none; }
      .forwho__grid { grid-template-columns: 1fr; }
      .product-grid { grid-template-columns: 1fr 1fr; gap: 20px; }
      .steps { grid-template-columns: 1fr 1fr; }
      .form-card { padding: 28px 20px; }
      .about, .forwho, .assortment, .howwork, .formblock, .contacts { padding: 56px 20px; }
      .partners { padding: 36px 20px; }
      .partners__row { gap: 28px; }
      .footer__inner { flex-direction: column; text-align: center; }
    }
    @media (max-width: 480px) {
      .product-grid { grid-template-columns: 1fr; }
      .steps { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

